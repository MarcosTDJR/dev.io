{
  "name": "devio-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Hub desktop de projetos para desenvolvedores",
  "author": "dev.io",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k \"vite\" \"node server/index.mjs\"",
    "api": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "pnpm build && electron .",
    "desktop:package": "pnpm build && electron-builder",
    "format": "oxfmt"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "build": {
    "appId": "io.devio.desktop",
    "productName": "dev.io",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Development"
    }
  }
}
