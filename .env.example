# Copie para .env apenas no ambiente local. Nunca versione o arquivo .env.
POSTGRES_DB=devio
POSTGRES_USER=devio_app
POSTGRES_PASSWORD=troque-por-um-segredo-gerado
POSTGRES_PORT=15432
DATABASE_URL=postgresql://devio_app:troque-por-um-segredo-gerado@localhost:15432/devio

# Usado apenas pelo workflow DAST contra um ambiente autorizado.
DAST_TARGET_URL=https://staging.example.com

# Google Identity Services. Use o mesmo Client ID no frontend e no backend.
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com