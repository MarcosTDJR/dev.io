POSTGRES_PORT=15432
DATABASE_URL=postgresql://devio_app:troque-por-um-segredo-gerado@localhost:15432/devio

# SMTP para confirmação de conta e recuperação de senha.
PUBLIC_APP_URL=http://localhost:8443
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Usado apenas pelo workflow DAST contra um ambiente autorizado.
DAST_TARGET_URL=https://staging.example.com

# Google Identity Services. Use o mesmo Client ID no frontend e no backend.
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Chave publishable do Supabase: apropriada para uso no navegador com RLS habilitado.
VITE_SUPABASE_URL=https://wfvzwktfggbsvwmgtwpr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_iLMotyxhbYDk5yGdnHjAvw_gsWGwxCW
VITE_ADMIN_API_URL=
VITE_API_URL=
VITE_PUBLIC_APP_URL=

# Chave privilegiada usada somente pela API Node para operações administrativas.
# Nunca use o prefixo VITE_ nem exponha esta chave no navegador.
